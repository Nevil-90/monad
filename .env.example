# Copy to .env and fill in:  cp .env.example .env
# Next.js reads it for the app (npm run dev / build); npm run relay / keeper / deploy read it for the scripts.
# Deployment values (contract, deploy block, relay URL, keys) have no built-in default: a missing one is
# reported by the feature that needs it instead of being guessed. Nothing here needs a paid API key.

# --- App (NEXT_PUBLIC_* values are built into the page: never put secrets in them) ---------------

# Price relay (npm run relay). Streams RedStone prices, the oracle the contract settles on.
NEXT_PUBLIC_PRICE_RELAY_URL=http://localhost:8787

# Development only, instead of the relay: Binance public streams (no MON market, not the settlement
# oracle). Ignored unless set to exactly "binance".
# NEXT_PUBLIC_PRICE_SOURCE=binance

# Deployed MonadUpDownAMM (printed by npm run deploy). Needed for Live mode and the Dashboard.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=

# Optional: override the public Monad testnet endpoints (e.g. the local chain from npm run dev:chain)
# NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_CHAIN_ID=10143

# Mainnet (only if you deploy there)
# NEXT_PUBLIC_MAINNET_CONTRACT_ADDRESS=
# NEXT_PUBLIC_MAINNET_DEPLOY_BLOCK=

# --- Server side only (never prefix with NEXT_PUBLIC_, never commit) ----------------------------

# Keeper and deployer signing keys (fund them with testnet MON from the Monad faucet)
KEEPER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# Price relay: port and the site allowed to read it (set your domain in production)
# PORT=8787
# ALLOWED_ORIGIN=https://your-site.example
