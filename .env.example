# Copy to .env:  cp .env.example .env
# Only what is needed to run on Monad testnet. Rare overrides are listed in the README.

# ---- Public: built into the web page, so never put a secret here ----------------------------

# Your deployed contract and the block it was deployed in (both printed by `npm run deploy`)
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=

# Where `npm run relay` runs (pushes contract events, block height and gas price; serves signed reports)
NEXT_PUBLIC_PRICE_RELAY_URL=http://localhost:8787

# Chart prices: "coinbase" (every trade, ~0.1 s, all four markets). "binance" has no MON market.
NEXT_PUBLIC_PRICE_SOURCE=coinbase

# ---- Secret: used only by the scripts on your machine or server; never share or commit -----

# Wallet that deploys the contract (npm run deploy) and wallet that locks/settles rounds (npm run keeper).
# They can be the same wallet. Fund them with testnet MON from the Monad faucet.
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=

# The relay's one central store (replaces data/*.json): contract events, derived bets/activity rows,
# and the Dashboard's paginated queries all live in this Supabase project. Only the relay (this .env)
# talks to it; the browser never sees these keys. Create a project at https://supabase.com/dashboard,
# then run supabase/schema.sql once in its SQL editor (Project > SQL Editor > New query > Run) before
# starting the relay.
# Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Project Settings -> API Keys -> service_role (secret; bypasses RLS so the relay can write). Never
# use the anon/public key here, and never put either key in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_KEY=
