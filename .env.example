# Copy to .env and fill in:  cp .env.example .env
# Vite reads it for the app (npm run dev / build); npm run relay / keeper / deploy read it for the scripts.
# Deployment values (contract, deploy block, relay, keys) have no built-in default: a missing one is reported by the
# feature that needs it instead of being guessed.

# --- Frontend (Vite) ---------------------------------------------------------------------------

# Pyth price relay (scripts/price_relay.js). This is the price source for the UI, and the same oracle
# the contract settles on. Required for MON/USD.
VITE_PRICE_RELAY_URL=http://localhost:8787

# Development only, instead of the relay: Binance public streams (no MON market, not the settlement
# oracle). Ignored when VITE_PRICE_RELAY_URL is set.
# VITE_PRICE_SOURCE=binance

# Deployed MonadUpDownAMM (printed by scripts/deploy.js). Needed for Live mode and the Dashboard.
VITE_CONTRACT_ADDRESS=
VITE_CONTRACT_DEPLOY_BLOCK=

# Optional: override the public Monad testnet endpoints (e.g. the local chain from `npm run dev:chain`)
# VITE_RPC_URL=https://testnet-rpc.monad.xyz
# VITE_CHAIN_ID=10143

# Mainnet (only if you deploy there)
# VITE_MAINNET_CONTRACT_ADDRESS=
# VITE_MAINNET_DEPLOY_BLOCK=
# VITE_MAINNET_PYTH_CONTRACT=

# --- Server-side only (never prefix with VITE_, never commit) -----------------------------------

# Pyth Hermes API key (Pyth Terminal). Used by the relay and the keeper.
PYTH_API_KEY=
# Optional: Hermes endpoint (default https://pyth.dourolabs.app/hermes)
# PYTH_HERMES_URL=
# Keeper and deployer signing keys
KEEPER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
