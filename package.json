{
  "name": "monad-updown-amm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "compile": "node scripts/compile.js",
    "test": "node test/app_logic.test.js",
    "test:evm": "node test/contract_evm.test.js",
    "test:security": "node test/security_regressions.test.js",
    "test:mutation": "node scripts/mutation_check.js",
    "dev:chain": "node scripts/dev_chain.js",
    "relay": "node --env-file-if-exists=.env scripts/price_relay.js",
    "keeper": "node --env-file-if-exists=.env scripts/keeper_bot.js",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.js",
    "test:all": "npm run compile && npm test && npm run test:evm && npm run test:security",
    "start": "next start -p 3000",
    "dev:app": "next dev -p 3000",
    "dev:testnet": "node scripts/dev.js --with-keeper",
    "retire": "node --env-file-if-exists=.env scripts/retire_contract.js",
    "test:fuzz": "node test/invariant_fuzz.test.js",
    "transfer-owner": "node --env-file-if-exists=.env scripts/transfer_owner.js",
    "test:challenge": "node --env-file-if-exists=.env scripts/challenge_test.js",
    "test:rounds": "node --env-file-if-exists=.env scripts/rounds_test.js",
    "test:edge": "node --env-file-if-exists=.env scripts/edge_test.js",
    "test:wallets": "node --env-file-if-exists=.env scripts/multi_wallet_test.js"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "ethers": "^6.17.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
