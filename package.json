{
  "name": "pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "compile": "node scripts/compile.js",
    "test": "node test/app_logic.test.js",
    "test:house": "node test/house_evm.test.js",
    "test:security": "node test/reentrancy.test.js",
    "test:load": "node test/load_20_users.test.js",
    "test:all": "npm run compile && npm test && npm run test:house && npm run test:security",
    "dev:house-chain": "node scripts/dev_house_chain.js",
    "relay": "node --env-file-if-exists=.env scripts/price_relay.js",
    "keeper": "node --env-file-if-exists=.env scripts/house_keeper.js",
    "deploy": "node --env-file-if-exists=.env scripts/deploy_house.js",
    "start": "next start -p 3000",
    "dev:app": "next dev -p 3000",
    "dev:testnet": "node scripts/dev.js --with-keeper",
    "retire": "node --env-file-if-exists=.env scripts/retire_contract.js",
    "transfer-owner": "node --env-file-if-exists=.env scripts/transfer_owner.js",
    "house": "node --env-file-if-exists=.env scripts/house_admin.js",
    "migrate:supabase": "node --env-file-if-exists=.env scripts/migrate_json_to_supabase.js"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "ethers": "^6.17.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
